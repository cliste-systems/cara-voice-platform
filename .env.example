# LiveKit voice worker (Cara-only) — see docs in cara-platform VOICE-WORKER-CONTRACT.md

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Worker name for explicit dispatch (production: cliste-retail-node).
LIVEKIT_AGENT_NAME=cliste-retail-node

# Dev dispatch fallbacks (production resolves org by dialed phone_numbers.e164)
# DEFAULT_ORG_PHONE=+353749389378
# CARA_TEST_CALLED_NUMBERS=+353749389378 — public Hello Cara demo only (not +353109307440 SuperValu QA)
# CARA_FACTORY_FRESH_CALLED_NUMBERS= — optional baseline line(s); +353749759508 is the Kavanaghs retail demo line
# DEFAULT_ORG_SLUG=my-business
# CARA_OFFLINE_PLAYGROUND=true — skip Supabase org lookup for LiveKit Console/Playground only (no phone_number in metadata). When a dialed number or org slug is present, Supabase lookup still runs. Never set in production.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# ORG_TIMEZONE=Europe/Dublin

# STT / LLM — Kavanaghs 9508 retail stack
# 9508 (+353749759508): GPT-Live-1 only — Irish voice `willow` (no AssemblyAI/Gemma/Cartesia fallback)
# OPENAI_API_KEY=  (required on 9508)
# CARA_GPT_LIVE_VOICE=willow
# CARA_GPT_LIVE_BACKEND_MODEL=gpt-5.6-luna
# CARA_GPT_LIVE_AUDIO_QUEUE_MS=8000  — native RoomIO queue capacity, not a guaranteed startup cushion
# CARA_GPT_LIVE_BURST_TIMEOUT_MS=8000  — idle gap before a duplex generation closes; SDK default is 800ms
# CARA_GPT_LIVE_PREBUFFER_MS=500  — default startup cushion and digital-silence replenishment; covers the observed 315ms delivery stall with headroom; explicit 0 disables for comparisons
# CARA_GPT_LIVE_AUDIO_DIAGNOSTICS=1  — numeric PCM timing/clipping counters; no audio or transcript capture
# CARA_GPT_LIVE_AUDIO_CAPTURE_DIR=outputs/audio-debug  — local debugging only: assistant PCM and phrase timings, capped at two minutes; no microphone input
# CARA_GPT_LIVE_OPENING_MANIFEST=assets/gpt-live/kavanaghs-willow.json  — checked fixed greeting; mismatched text, voice or audio stops startup
# CARA_GPT_LIVE_RETAIL=0  — emergency only: disables GPT-Live on 9508 (call will fail until re-enabled)
#
# Inference stack for other production lines and demo/test calls:
# LIVEKIT_INFERENCE_STT_MODEL=assemblyai/universal-3-5-pro
# CARA_LLM_PROVIDER=gateway
# LIVEKIT_INFERENCE_LLM_MODEL=google/gemma-4-31b-it
# LIVEKIT_STT_WARMUP=1
# LIVEKIT_STT_WARMUP_TIMEOUT_MS=2500
# LIVEKIT_INFERENCE_STT_LANGUAGE=en
# STT tuning (AssemblyAI universal-3-5-pro)
# LIVEKIT_STT_LATENCY_PROFILE=snappy
# snappy (default): faster replies — 200/1000ms silence, EOT 0.35
# balanced: prior accuracy-first tuning — 300/1400ms, EOT 0.4
# LIVEKIT_STT_MIN_TURN_SILENCE_MS=200
# LIVEKIT_STT_MAX_TURN_SILENCE_MS=1000
# LIVEKIT_STT_EOT_CONFIDENCE=0.35
# LIVEKIT_STT_DOMAIN_PROMPT=  (optional override; default built from org name)
# LIVEKIT_STT_EXTRA_KEYTERMS=Grafton,Dublin
# LIVEKIT_INFERENCE_LLM_MODEL=google/gemma-4-31b-it
# LIVEKIT_LLM_TEMPERATURE=0.7
# LIVEKIT_LLM_MAX_TOKENS=320
# LIVEKIT_LLM_FREQUENCY_PENALTY=0
# LIVEKIT_LLM_PRESENCE_PENALTY=0
# CARA_PERSONA_VARIETY=on
# Demo/test line — balanced STT + longer endpointing (defaults in code if unset):
# LIVEKIT_TEST_STT_LATENCY_PROFILE=balanced
# LIVEKIT_TEST_STT_MIN_TURN_SILENCE_MS=400
# LIVEKIT_TEST_STT_MAX_TURN_SILENCE_MS=1400
# LIVEKIT_TEST_ENDPOINTING_MAX_MS=1200
# LIVEKIT_TEST_PREEMPTIVE_GENERATION=1
# openai-direct only if you have OpenAI credits: CARA_LLM_PROVIDER=openai-direct + OPENAI_API_KEY

# Cartesia TTS via LiveKit Inference (default: Siobhan)
# LIVEKIT_INFERENCE_TTS_MODEL=cartesia/sonic-3.6
# LIVEKIT_INFERENCE_TTS_VOICE=d79d2b77-9192-4e10-9407-5d43ca034803
# LIVEKIT_INFERENCE_TTS_LANGUAGE=en
# CARA_TRANSCRIPT_MIRROR_DIR=call-transcripts
# CARA_TRANSCRIPT_OPEN=0
# CARA_TRANSCRIPT_POLL_MS=3000
# CARA_TRANSCRIPT_WAIT_MS=120000
# CARA_TRANSCRIPT_WAIT=1
# CARA_TRANSCRIPT_ORG_NAME=Kavanaghs SuperValu

# Voice worker → dashboard webhooks (same secret in cara-platform Vercel env)
# CLISTE_APP_URL=https://app.hellocara.ie
CLISTE_APP_URL=
CLISTE_VOICE_WEBHOOK_SECRET=

# Direct Twilio SMS (primary path for routing links)
# CARA_SMS_DRY_RUN=true — log [sms] dry_run and return success without Twilio (phone test flow)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Platform sender for owner alerts only — NOT used for caller routing links
# TWILIO_SMS_FROM=+447...
# Irish org DID (+353…) SMS requires Twilio IE1 regional credentials (Console → Ireland region → API keys)
# TWILIO_IE1_AUTH_TOKEN=
# Or: TWILIO_IE1_API_KEY= + TWILIO_IE1_API_SECRET=
# TWILIO_IE1_ALPHA_SENDER=Kavanaghs
# TWILIO_IE1_MESSAGING_SERVICE_SID=MG...
# CLISTE_VOICE_HTTP_TIMEOUT_MS=6000
# CLISTE_VOICE_CALL_COMPLETE_TIMEOUT_MS=15000
# CLISTE_CALL_POSTPROCESS_TIMEOUT_MS=12000
# LIVEKIT_TRANSCRIPT_FLUSH_MS=300
# LIVEKIT_DISCONNECT_PLAYOUT_MS=2400
# LIVEKIT_END_CALL_POST_SPEECH_MS=120
# LIVEKIT_POST_GREETING_GRACE_MS=5000
# LIVEKIT_TEST_POST_GREETING_GRACE_MS=2500
# LIVEKIT_TEST_PREEMPTIVE_GENERATION=1
# LIVEKIT_PREEMPTIVE_GENERATION=0

# Optional stall phrase during slow tool/SMS work — retail 9508 defaults to 350ms when unset.
# LIVEKIT_RESPONSE_FILLER_MS=1200
# LIVEKIT_RESPONSE_FILLER_MAX_PER_CALL=5
# LIVEKIT_DEAD_AIR_MS=7000
# LIVEKIT_DEAD_AIR_CLOSE_MS=8000
# LIVEKIT_DEAD_AIR_MAX_PROMPTS=2

# Endpointing / turn detection
# LIVEKIT_ENDPOINTING_MIN_MS=0
# LIVEKIT_ENDPOINTING_MAX_MS=0
# LIVEKIT_USE_TURN_DETECTOR=on
# LIVEKIT_LLM_TEMPERATURE=0.55
# LIVEKIT_LLM_MAX_TOKENS=120

# Org config cache (ms). Default 30s.
# CLISTE_ORG_CACHE_TTL_MS=30000

# GDPR transcript retention for scripts/gdpr-purge-transcripts.ts
# CLISTE_TRANSCRIPT_RETENTION_DAYS=30

# Call recording (LiveKit egress → staging bucket → Supabase call-recordings)
# Enabled by default when LiveKit + Supabase service role + egress S3 are set.
# CALL_RECORDING_ENABLED=0 — disable egress recording
#
# LiveKit egress cannot upload to Supabase Storage S3 (SignatureDoesNotMatch).
# Use Cloudflare R2 (recommended) or AWS S3 for egress staging, then the worker
# copies the MP3 into Supabase via the service role after each call.
#
# Cloudflare R2 example:
# CALL_RECORDING_EGRESS_S3_ACCESS_KEY=
# CALL_RECORDING_EGRESS_S3_SECRET_KEY=
# CALL_RECORDING_EGRESS_S3_BUCKET=cliste-call-recordings
# CALL_RECORDING_EGRESS_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# CALL_RECORDING_EGRESS_S3_REGION=auto

# Ring-time smoke: RING_SMOKE_PHONE=+353... npm run test:ring-smoke

# --- Estimated call cost (USD) for admin / call_logs.cost_estimate ---
# CALL_COST_LIVEKIT_USD_PER_MIN=0.01
# CALL_COST_STT_USD_PER_MIN=0.0075
# CALL_COST_STT_BILLED_FRACTION_OF_WALL=1
# CALL_COST_CARTESIA_USD_PER_1M_CHARS=50
# CALL_COST_TWILIO_VOICE_USD_PER_MIN=0.006
# CALL_COST_TWILIO_SMS_USD_EACH=0.008

# Maximum live call duration (minutes); default 30, clamped to 1–120.
# CLISTE_MAX_CALL_MINUTES=30

# Browser/admin demos only: restore AssemblyAI + Gemma + Cartesia Siobhan.
# CARA_ADMIN_DEMO_STACK=legacy
